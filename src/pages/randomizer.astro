---
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";
import { QUOTES } from "~/data/quotes";

const ideas = await getCollection("ideas");
const data = ideas.map((i) => ({ id: i.id, ...i.data }));

const SUBREGION_LABEL: Record<string, string> = {
  westside: "Westside",
  eastside: "Eastside",
  middle: "Middle",
  north: "North",
  north_bay: "North Bay & Marin",
  east_bay: "East Bay",
  peninsula_south: "Peninsula & South",
};

const SF_SUBS = ["westside", "eastside", "middle", "north"];
const OUT_SUBS = ["north_bay", "east_bay", "peninsula_south"];

const sfGrouped = SF_SUBS.map((s) => ({
  sub: s,
  label: SUBREGION_LABEL[s],
  items: data.filter((d) => d.region === "sf" && d.subregion === s),
})).filter((g) => g.items.length > 0);

const outGrouped = OUT_SUBS.map((s) => ({
  sub: s,
  label: SUBREGION_LABEL[s],
  items: data.filter((d) => d.region === "bay_area" && d.subregion === s),
})).filter((g) => g.items.length > 0);

const LOCATION_GROUPS = [
  {
    label: "San Francisco",
    key: "sf",
    chips: [
      { id: "sf:westside", label: "Westside" },
      { id: "sf:eastside", label: "Eastside" },
      { id: "sf:middle", label: "Middle" },
      { id: "sf:north", label: "North" },
    ],
  },
  {
    label: "Outside the City",
    key: "bay_area",
    chips: [
      { id: "bay_area:north_bay", label: "North Bay & Marin" },
      { id: "bay_area:east_bay", label: "East Bay" },
      { id: "bay_area:peninsula_south", label: "Peninsula & South" },
    ],
  },
];

const ACCESS_CHIPS = [
  { id: "car", label: "Car" },
  { id: "ferry", label: "Ferry" },
  { id: "bart", label: "BART" },
  { id: "caltrain", label: "Caltrain" },
  { id: "smart", label: "SMART" },
  { id: "bus", label: "Bus" },
];

const allTags = new Set<string>();
data.forEach((d) => d.tags.forEach((t) => allTags.add(t)));
const VIBE_CHIPS = Array.from(allTags)
  .sort()
  .map((t) => ({ id: t, label: t.replace("-", " ") }));
---

<Base title="Date Randomizer — a botanical oracle">
  <section class="wrap">
    <header class="head">
      <p class="caps eyebrow">Project I</p>
      <h1 class="title">A Botanical Oracle</h1>
      <p class="script sub">for choosing an afternoon</p>
      <p class="blurb">
        Fifty-eight specimens catalogued from field notes. Narrow by
        where, how you'd get there, and the kind of day you want —
        then let the notebook pick one.
      </p>
    </header>

    <div class="card" id="card" data-state="idle">
      <svg class="card-vine" viewBox="0 0 680 340" preserveAspectRatio="none" aria-hidden="true">
        <path d="M20 20 Q 340 4 660 20 Q 676 170 660 320 Q 340 336 20 320 Q 4 170 20 20 Z"/>
      </svg>

      <div class="aperture" id="aperture" aria-live="polite">
        <div class="ticker-slot">
          <span class="ticker" id="ticker"></span>
        </div>
        <figure class="quote" id="quote">
          <blockquote id="quote-text"></blockquote>
          <figcaption id="quote-author"></figcaption>
        </figure>
      </div>

      <div class="meta" id="meta" hidden>
        <div class="meta-row">
          <span class="meta-label">where</span>
          <span class="meta-val" id="meta-where"></span>
        </div>
        <div class="meta-row" id="meta-access-row" hidden>
          <span class="meta-label">access</span>
          <span class="meta-val" id="meta-access"></span>
        </div>
        <div class="meta-row">
          <span class="meta-label">vibe</span>
          <span class="meta-val tag-list" id="meta-tags"></span>
        </div>
        <p class="script stamp" id="stamp">today's expedition</p>
      </div>
    </div>

    <div class="controls">
      <button class="pick" id="pick" type="button">
        <span class="pick-inner">Randomize</span>
      </button>
      <button class="reset" id="reset" type="button">Reset filters</button>
      <p class="pool" id="pool"></p>
    </div>

    <section class="filters">
      <h2 class="caps filter-title">Filters</h2>

      <fieldset class="group">
        <legend class="caps">Location</legend>
        {
          LOCATION_GROUPS.map((g) => (
            <div class="group-row">
              <span class="group-label">{g.label}</span>
              <div class="chips">
                {g.chips.map((c) => (
                  <button
                    type="button"
                    class="chip"
                    data-kind="location"
                    data-value={c.id}
                  >
                    <span class="mark" aria-hidden="true" />
                    {c.label}
                  </button>
                ))}
              </div>
            </div>
          ))
        }
      </fieldset>

      <fieldset class="group">
        <legend class="caps">Access (out of the city)</legend>
        <div class="chips">
          {
            ACCESS_CHIPS.map((c) => (
              <button
                type="button"
                class="chip"
                data-kind="access"
                data-value={c.id}
              >
                <span class="mark" aria-hidden="true" />
                {c.label}
              </button>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="group">
        <legend class="caps">Vibe</legend>
        <div class="chips">
          {
            VIBE_CHIPS.map((c) => (
              <button
                type="button"
                class="chip"
                data-kind="tag"
                data-value={c.id}
              >
                <span class="mark" aria-hidden="true" />
                {c.label}
              </button>
            ))
          }
        </div>
      </fieldset>
    </section>

    <section class="catalogue" id="catalogue">
      <h2 class="caps filter-title">The Full Catalogue</h2>
      <p class="cat-note" id="cat-note"></p>

      <details class="cat-region" open>
        <summary class="cat-head">
          <svg class="leafmark" viewBox="0 0 24 24" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12 H 20" />
              <path d="M12 4 C 16 6, 18 8, 19 12 C 15 11, 12 9, 12 4 Z" fill="currentColor" fill-opacity="0.18" />
              <path d="M12 20 C 8 18, 6 16, 5 12 C 9 13, 12 15, 12 20 Z" fill="currentColor" fill-opacity="0.18" />
            </g>
          </svg>
          <span class="cat-head-label">In the City</span>
          <span class="cat-head-rule" aria-hidden="true"></span>
          <span class="cat-head-count" data-count="sf">{
            data.filter((d) => d.region === "sf").length
          }</span>
        </summary>
        <div class="cat-body">
          <div class="cat-body-inner">
            {
              sfGrouped.map((g) => (
                <details class="cat-group" data-sub={g.sub} open>
                  <summary class="cat-sub">{g.label}</summary>
                  <div class="cat-body">
                    <div class="cat-body-inner">
                      <ul class="cat-list">
                        {g.items.map((item) => (
                          <li
                            class="cat-item"
                            data-id={item.id}
                            data-region={item.region}
                            data-sub={item.subregion}
                            data-loc-key={`${item.region}:${item.subregion}`}
                            data-access={item.access.join(",")}
                            data-tags={item.tags.join(",")}
                          >
                            <span class="cat-title">{item.title}</span>
                            <span class="cat-tags">
                              {item.tags.map((t) => (
                                <span class="cat-tag">{t.replace("-", " ")}</span>
                              ))}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </details>

      <details class="cat-region" open>
        <summary class="cat-head">
          <svg class="leafmark" viewBox="0 0 24 24" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12 H 20" />
              <path d="M12 4 C 16 6, 18 8, 19 12 C 15 11, 12 9, 12 4 Z" fill="currentColor" fill-opacity="0.18" />
              <path d="M12 20 C 8 18, 6 16, 5 12 C 9 13, 12 15, 12 20 Z" fill="currentColor" fill-opacity="0.18" />
            </g>
          </svg>
          <span class="cat-head-label">Beyond the City</span>
          <span class="cat-head-rule" aria-hidden="true"></span>
          <span class="cat-head-count" data-count="bay_area">{
            data.filter((d) => d.region === "bay_area").length
          }</span>
        </summary>
        <div class="cat-body">
          <div class="cat-body-inner">
            {
              outGrouped.map((g) => (
                <details class="cat-group" data-sub={g.sub} open>
                  <summary class="cat-sub">{g.label}</summary>
                  <div class="cat-body">
                    <div class="cat-body-inner">
                      <ul class="cat-list">
                        {g.items.map((item) => (
                          <li
                            class="cat-item"
                            data-id={item.id}
                            data-region={item.region}
                            data-sub={item.subregion}
                            data-loc-key={`${item.region}:${item.subregion}`}
                            data-access={item.access.join(",")}
                            data-tags={item.tags.join(",")}
                          >
                            <span class="cat-title">{item.title}</span>
                            <span class="cat-access">
                              {item.access.map((a) => (
                                <span class="cat-access-chip">{a}</span>
                              ))}
                            </span>
                            <span class="cat-tags">
                              {item.tags.map((t) => (
                                <span class="cat-tag">{t.replace("-", " ")}</span>
                              ))}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </details>
    </section>

    <p class="back"><a href={import.meta.env.BASE_URL}>← back to the notebook</a></p>
  </section>

  <script is:inline define:vars={{ data, quotes: QUOTES }}>
    window.__IDEAS__ = data;
    window.__QUOTES__ = quotes;
  </script>
  <script is:inline>
    // Delay <details open=false> until the slide-up animation finishes so the
    // grid-row collapse has time to play.
    document
      .querySelectorAll("details.cat-region, details.cat-group")
      .forEach((el) => {
        const summary = el.querySelector(":scope > summary");
        if (!summary) return;
        summary.addEventListener("click", (e) => {
          if (!el.open) return;
          e.preventDefault();
          el.classList.add("closing");
          window.setTimeout(() => {
            el.open = false;
            el.classList.remove("closing");
          }, 380);
        });
      });
  </script>
  <script>
    import "~/components/Randomizer.ts";
  </script>
</Base>

<style>
  .wrap {
    max-width: 44rem;
    margin: 0 auto;
  }
  .head {
    text-align: center;
    margin-bottom: 2.4rem;
  }
  .eyebrow {
    margin: 0 0 1rem;
  }
  .title {
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-variation-settings: "SOFT" 100, "opsz" 144, "wght" 380;
    line-height: 1.08;
  }
  .sub {
    margin: 0.3rem 0 1.2rem;
  }
  .blurb {
    max-width: 28rem;
    margin: 0 auto;
    color: var(--ink-soft);
    font-style: italic;
  }

  .card {
    position: relative;
    padding: 2.6rem 2rem 2.2rem;
    min-height: 260px;
    background: color-mix(in srgb, var(--paper-warm) 60%, var(--paper));
    box-shadow:
      0 1px 0 rgba(60, 45, 25, 0.06),
      0 18px 40px -24px rgba(60, 45, 25, 0.25);
  }
  .card-vine {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--sage-deep);
    overflow: visible;
  }
  .card-vine path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
    opacity: 0.6;
  }
  .card[data-state="revealed"] .card-vine path {
    animation: draw 1400ms ease-out forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .aperture {
    position: relative;
    min-height: 5.2em;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .ticker-slot {
    position: relative;
    overflow: hidden;
    padding: 0.3em 0;
    width: 100%;
  }
  .card[data-state="idle"] .ticker-slot {
    display: none;
  }
  .card:not([data-state="idle"]) .quote {
    display: none;
  }
  .quote {
    margin: 0;
    padding: 0.4em 0.6em;
    max-width: 34rem;
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--display);
    font-variation-settings: "SOFT" 60, "opsz" 144, "wght" 360;
    font-style: italic;
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    line-height: 1.4;
    color: var(--ink);
    position: relative;
  }
  .quote blockquote::before {
    content: "\201C";
    font-family: var(--display);
    font-size: 2.6em;
    line-height: 0.2;
    color: var(--sage);
    vertical-align: -0.45em;
    margin-right: 0.05em;
    opacity: 0.7;
  }
  .quote figcaption {
    margin-top: 0.9rem;
    font-family: var(--body);
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .quote figcaption::before {
    content: "— ";
    color: var(--sage-deep);
  }
  .ticker {
    display: block;
    font-family: var(--display);
    font-variation-settings: "SOFT" 60, "opsz" 144, "wght" 380;
    font-size: clamp(1.45rem, 3.4vw, 2.1rem);
    line-height: 1.2;
    color: var(--ink);
    will-change: transform, opacity, filter;
  }
  .ticker.rolling {
    transform: translateY(-4px);
    filter: blur(0.6px);
    opacity: 0.9;
  }
  .ticker.settling {
    animation: settle 280ms ease-out both;
  }
  @keyframes settle {
    0% {
      transform: translateY(6px);
      filter: blur(1.4px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      filter: blur(0);
      opacity: 1;
    }
  }

  .meta {
    margin-top: 1.6rem;
    padding-top: 1.2rem;
    border-top: 1px dashed
      color-mix(in srgb, var(--ink) 16%, transparent);
    display: grid;
    gap: 0.6rem;
    opacity: 0;
    animation: fadein 400ms ease-out 180ms forwards;
  }
  .meta[hidden] {
    display: none;
  }
  @keyframes fadein {
    to {
      opacity: 1;
    }
  }
  .meta-row {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-size: 1rem;
  }
  .meta-label {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 0.68rem;
    color: var(--muted);
    width: 4.2rem;
    flex-shrink: 0;
  }
  .meta-val {
    color: var(--ink-soft);
    font-style: italic;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-style: normal;
  }
  .tag-list .tag {
    padding: 0.1rem 0.55rem;
    border: 1px solid
      color-mix(in srgb, var(--sage-deep) 40%, transparent);
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--sage-deep);
    background: color-mix(in srgb, var(--sage) 8%, transparent);
  }
  .stamp {
    grid-column: 1 / -1;
    text-align: right;
    color: var(--terracotta-deep);
    opacity: 0.85;
    margin-top: 0.4rem;
  }

  .controls {
    margin: 1.6rem 0 2.6rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .pick {
    font-family: var(--display);
    font-size: 1rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.85rem 1.8rem;
    background: transparent;
    color: var(--terracotta-deep);
    border: 1.5px solid var(--terracotta);
    cursor: pointer;
    position: relative;
    transition:
      background 220ms ease,
      color 220ms ease,
      transform 120ms ease;
  }
  .pick:hover {
    background: var(--terracotta);
    color: var(--paper);
  }
  .pick:active {
    transform: translateY(1px);
  }
  .pick[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .reset {
    background: none;
    border: none;
    color: var(--muted);
    font-family: var(--body);
    font-style: italic;
    font-size: 0.95rem;
    cursor: pointer;
    padding: 0.4rem 0.6rem;
  }
  .reset:hover {
    color: var(--ink);
  }
  .pool {
    width: 100%;
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    font-style: italic;
    margin: 0;
  }

  .filters {
    border-top: var(--rule);
    padding-top: 2rem;
  }
  .filter-title {
    text-align: center;
    margin: 0 0 1.6rem;
  }
  .group {
    border: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }
  .group legend {
    padding: 0;
    margin-bottom: 0.7rem;
  }
  .group-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 0.6rem;
    align-items: start;
    margin-bottom: 0.6rem;
  }
  .group-label {
    font-family: var(--display);
    font-style: italic;
    color: var(--muted);
    padding-top: 0.35rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid
      color-mix(in srgb, var(--ink) 28%, transparent);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    font-family: var(--body);
    font-size: 0.92rem;
    cursor: pointer;
    text-transform: capitalize;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }
  .chip:hover {
    border-color: var(--sage-deep);
    color: var(--ink);
  }
  .chip .mark {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: transparent;
    border: 1px solid
      color-mix(in srgb, var(--ink) 26%, transparent);
  }
  .chip[aria-pressed="true"] {
    background: var(--sage);
    border-color: var(--sage-deep);
    color: var(--paper);
  }
  .chip[aria-pressed="true"] .mark {
    background: var(--paper);
    border-color: var(--paper);
  }
  .chip[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .catalogue {
    margin-top: 4rem;
    padding-top: 2.4rem;
    border-top: var(--rule);
  }
  .cat-note {
    text-align: center;
    color: var(--muted);
    font-style: italic;
    font-size: 0.9rem;
    margin: -0.6rem 0 2rem;
    min-height: 1.2em;
  }
  .cat-region {
    margin-bottom: 2rem;
  }
  .cat-region > summary,
  .cat-group > summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
  }
  .cat-region > summary::-webkit-details-marker,
  .cat-group > summary::-webkit-details-marker,
  .cat-region > summary::marker,
  .cat-group > summary::marker {
    display: none;
    content: "";
  }
  .cat-region > summary:focus-visible,
  .cat-group > summary:focus-visible {
    outline: 1px dotted var(--sage-deep);
    outline-offset: 4px;
  }

  .cat-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.4rem 0 1rem;
    font-family: var(--display);
    font-variation-settings: "SOFT" 80, "opsz" 144, "wght" 420;
    font-size: 1.3rem;
    color: var(--ink);
  }
  .leafmark {
    display: inline-block;
    flex-shrink: 0;
    width: 1.05em;
    height: 1.05em;
    color: var(--sage-deep);
    transform: rotate(90deg);
    transform-origin: 50% 50%;
    transition:
      transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1),
      color 220ms ease;
  }
  .cat-region:not([open]) > summary .leafmark {
    transform: rotate(0deg);
  }
  .cat-region > summary:hover .leafmark {
    color: var(--terracotta-deep);
  }
  .cat-head-label {
    transition: letter-spacing 320ms ease;
  }
  .cat-region:not([open]) > summary:hover .cat-head-label {
    letter-spacing: 0.015em;
  }
  .cat-head-rule {
    flex: 1;
    border-bottom: 1px solid
      color-mix(in srgb, var(--sage-deep) 38%, transparent);
    transform: translateY(-0.2em);
    transition: opacity 300ms ease;
  }
  .cat-region:not([open]) > summary .cat-head-rule {
    opacity: 0.5;
  }
  .cat-head-count {
    font-family: var(--body);
    font-size: 0.85rem;
    font-style: italic;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .cat-group {
    margin-bottom: 1.1rem;
  }
  .cat-group[hidden] {
    display: none;
  }
  .cat-sub {
    display: inline-block;
    font-family: var(--display);
    font-style: italic;
    font-size: 0.98rem;
    font-weight: 400;
    color: var(--sage-deep);
    margin: 0 0 0.5rem;
    padding: 0.15rem 0;
    border-bottom: 1px solid transparent;
    letter-spacing: 0.02em;
    transition:
      color 220ms ease,
      border-color 220ms ease,
      letter-spacing 300ms ease;
  }
  .cat-group[open] > summary .cat-sub {
    color: var(--ink);
    border-bottom-color:
      color-mix(in srgb, var(--sage-deep) 32%, transparent);
  }
  .cat-group:not([open]) > summary:hover .cat-sub {
    color: var(--ink);
    letter-spacing: 0.06em;
    border-bottom-color:
      color-mix(in srgb, var(--sage-deep) 22%, transparent);
  }

