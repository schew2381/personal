---
import vineLeft from "~/assets/botanicals/vine-left.svg?raw";
import vineRight from "~/assets/botanicals/vine-right.svg?raw";
import fern from "~/assets/botanicals/fern.svg?raw";
import wildflower from "~/assets/botanicals/wildflower.svg?raw";

interface Props {
  variant?: "home" | "page";
}
const { variant = "page" } = Astro.props;
---

<div class={`botanicals botanicals--${variant}`} aria-hidden="true">
  <div class="bot bot--left" set:html={vineLeft} />
  <div class="bot bot--right" set:html={vineRight} />
  <div class="bot bot--fern" set:html={fern} />
  {variant === "home" && <div class="bot bot--flower" set:html={wildflower} />}
</div>

<style>
  .botanicals {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    color: var(--sage);
  }
  .bot {
    position: absolute;
  }
  .bot :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .bot--left {
    top: -30px;
    left: -40px;
    width: 170px;
    height: 900px;
    opacity: 0.78;
    animation: sway 14s ease-in-out infinite alternate;
  }
  .bot--right {
    top: -20px;
    right: -50px;
    width: 170px;
    height: 900px;
    opacity: 0.7;
    animation: sway 17s ease-in-out infinite alternate-reverse;
  }
  .bot--fern {
    bottom: -40px;
    right: 2vw;
    width: 260px;
    height: 320px;
    opacity: 0.45;
    color: var(--sage-deep);
    transform: rotate(-6deg);
  }
  .bot--flower {
    top: 10vh;
    right: 6vw;
    width: 140px;
    height: 180px;
    opacity: 0.55;
    color: var(--terracotta);
    transform: rotate(8deg);
  }
  @keyframes sway {
    from {
      transform: translateY(0) rotate(-0.6deg);
    }
    to {
      transform: translateY(8px) rotate(0.6deg);
    }
  }
  @media (max-width: 720px) {
    .bot--left,
    .bot--right {
      width: 110px;
      opacity: 0.5;
    }
    .bot--fern {
      width: 180px;
      height: 220px;
      opacity: 0.3;
    }
    .bot--flower {
      display: none;
    }
  }
</style>
