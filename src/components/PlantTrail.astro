---
import type { ImageMetadata } from "astro";

type Module = { default: ImageMetadata };
const modules = import.meta.glob<Module>(
  "~/assets/plant_stages/*/stage_*.png",
  { eager: true },
);

// Group modules by plant folder, sort by stage number.
const byPlant = new Map<string, { stage: number; src: string }[]>();
for (const [path, mod] of Object.entries(modules)) {
  const match = path.match(/plant_stages\/([^/]+)\/stage_(\d+)\.png$/);
  if (!match) continue;
  const [, plant, n] = match;
  const stage = Number(n);
  if (!byPlant.has(plant)) byPlant.set(plant, []);
  byPlant.get(plant)!.push({ stage, src: mod.default.src });
}
const plants = Array.from(byPlant.entries())
  .map(([name, stages]) => ({
    name,
    stages: stages.sort((a, b) => a.stage - b.stage).map((s) => s.src),
  }))
  .filter((p) => p.stages.length === 6);
---

<div id="plant-trail" aria-hidden="true"></div>

<script is:inline define:vars={{ plants }}>
  window.__PLANTS__ = plants;
</script>

<script>
  type Plant = { name: string; stages: string[] };

  const layer = document.getElementById("plant-trail");
  const plants = (window as unknown as { __PLANTS__: Plant[] }).__PLANTS__;

  const MIN_INTERVAL = 1800; // ms between spawns
  const MIN_TRAVEL = 180; // px since last spawn
  const MAX_LIVE = 4;
  // Stage slots sum to 16000ms. Each later stage is longer; stage 6 holds
  // the longest. Minimum slot is 1500ms so no transition ever feels rushed.
  const STAGE_SLOTS = [1500, 1700, 2000, 2500, 3300, 5000];
  const LIFECYCLE = STAGE_SLOTS.reduce((a, b) => a + b, 0);
  const SPAWN_MS = 900;
  const FADE_MS = 1600;
  const INTERACTIVE_SEL =
    'a, button, summary, input, label, [role="button"]';

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const coarse = window.matchMedia("(hover: none)");
  let lastSpawn = 0;
  let lastX = -9999;
  let lastY = -9999;
  let lastPlant = "";
  let pageHidden = document.visibilityState === "hidden";

  interface Live {
    el: HTMLElement;
    x: number;
    y: number;
    w: number;
  }
  const live: Live[] = [];

  document.addEventListener("visibilitychange", () => {
    pageHidden = document.visibilityState === "hidden";
  });

  function rand(min: number, max: number) {
    return min + Math.random() * (max - min);
  }

  function pickPlant(): Plant {
    if (plants.length === 0)
      return { name: "", stages: [] };
    if (plants.length === 1) return plants[0];
    let p: Plant;
    do {
      p = plants[Math.floor(Math.random() * plants.length)];
    } while (p.name === lastPlant);
    lastPlant = p.name;
    return p;
  }

  function clampToViewport(x: number, y: number, w: number) {
    const margin = 12;
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const halfW = w / 2;
    const cx = Math.max(halfW + margin, Math.min(vw - halfW - margin, x));
    // y is the bottom of the plant; clamp so top stays on-screen and bottom
    // stays off the very edge.
    const h = w * 1.1;
    const cy = Math.max(h + margin, Math.min(vh - margin, y));
    return { x: cx, y: cy };
  }

  function findSpot(x: number, y: number, w: number) {
    for (let attempt = 0; attempt < 4; attempt++) {
      let { x: cx, y: cy } = clampToViewport(x, y, w);
      const collides = live.some((l) => {
        const dx = l.x - cx;
        const dy = l.y - cy;
        const min = ((l.w + w) / 2) * 0.65;
        return Math.hypot(dx, dy) < min;
      });
      if (!collides) return { x: cx, y: cy, ok: true };
      if (attempt === 3) break;
      const angle = Math.random() * Math.PI * 2;
      const r = rand(20, 36);
      x += Math.cos(angle) * r;
      y += Math.sin(angle) * r;
    }
    return { x: 0, y: 0, ok: false };
  }

  function spawn(rawX: number, rawY: number) {
    if (!layer || reduced.matches || pageHidden) return;
    if (live.length >= MAX_LIVE) return;
    const now = performance.now();
    if (now - lastSpawn < MIN_INTERVAL) return;

    const width = Math.round(rand(88, 120));
    const spot = findSpot(rawX, rawY, width);
    if (!spot.ok) return;

    const plant = pickPlant();
    if (plant.stages.length === 0) return;

    const el = document.createElement("div");
    el.className = "plant";
    el.style.setProperty("--w", `${width}px`);
    el.style.setProperty("--rot", `${rand(-6, 6).toFixed(2)}deg`);
    el.style.left = `${spot.x}px`;
    el.style.top = `${spot.y}px`;

    const stagesCount = plant.stages.length;
    // Cumulative start time of each stage.
    const starts: number[] = [];
    let running = 0;
    for (let i = 0; i < stagesCount; i++) {
      starts.push(running);
      running += STAGE_SLOTS[i] ?? STAGE_SLOTS[STAGE_SLOTS.length - 1];
    }
    const OVERLAP = 650; // ms of crossfade between adjacent stages
    const EASE = "cubic-bezier(0.42, 0, 0.58, 1)"; // symmetric S-curve
    plant.stages.forEach((src, i) => {
      const img = document.createElement("img");
      img.src = src;
      img.alt = "";
      img.draggable = false;
      img.className = `stage stage-${i}`;
      // Two independent animations per stage: fade-in then (for all but
      // the last stage) fade-out. Using the SAME symmetric S-curve for
      // both means during a crossfade the outgoing and incoming stages
      // sum to ~1 opacity throughout — no ghost, no peak, no dip.
      //
      // Use `forwards`, not `both`: with `both`, the fade-out's
      // backward fill would lock opacity to 1 during every delay
      // period before its start, overriding the fade-in entirely and
      // making stages pop instead of fade. `forwards` only fills AFTER
      // the animation ends, letting the CSS default opacity: 0 govern
      // the pre-animation state.
      const inDelay = starts[i];
      const outDelay = starts[i] + STAGE_SLOTS[i];
      const anims = [
        `stage-fade-in ${OVERLAP}ms ${EASE} ${inDelay}ms forwards`,
      ];
      if (i !== stagesCount - 1) {
        anims.push(
          `stage-fade-out ${OVERLAP}ms ${EASE} ${outDelay}ms forwards`,
        );
      }
      img.style.animation = anims.join(", ");
      el.appendChild(img);
    });

    const tracked: Live = { el, x: spot.x, y: spot.y, w: width };
    live.push(tracked);
    layer.appendChild(el);

    const lifespan = SPAWN_MS + LIFECYCLE + FADE_MS;
    window.setTimeout(() => {
      el.classList.add("fading");
      window.setTimeout(() => {
        el.remove();
        const idx = live.indexOf(tracked);
        if (idx >= 0) live.splice(idx, 1);
      }, FADE_MS);
    }, SPAWN_MS + LIFECYCLE);

    lastSpawn = now;
    lastX = rawX;
    lastY = rawY;
  }

  function onPointerMove(e: PointerEvent) {
    if (pageHidden || reduced.matches) return;
    if (coarse.matches && e.pointerType === "touch") return;
    const dx = e.clientX - lastX;
    const dy = e.clientY - lastY;
    if (Math.hypot(dx, dy) < MIN_TRAVEL) return;
    spawn(e.clientX, e.clientY);
  }

  function onPointerDown(e: PointerEvent) {
    if (pageHidden || reduced.matches) return;
    const t = e.target as Element | null;
    if (t && t.closest && t.closest(INTERACTIVE_SEL)) return;
    spawn(e.clientX, e.clientY);
  }

  if (!reduced.matches) {
    window.addEventListener("pointermove", onPointerMove, { passive: true });
    window.addEventListener("pointerdown", onPointerDown, { passive: true });
  }
</script>

<style is:global>
  #plant-trail {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    overflow: hidden;
  }

  #plant-trail .plant {
    --w: 100px;
    --rot: 0deg;
    position: absolute;
    width: var(--w);
    height: calc(var(--w) * 1.1);
    transform: translate(-50%, -100%) rotate(var(--rot)) scale(0.3)
      translateY(8px);
    transform-origin: 50% 100%;
    opacity: 0;
    animation: plant-in 800ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    will-change: transform, opacity;
  }
  #plant-trail .plant.fading {
    animation: plant-out 1400ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  #plant-trail .stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    opacity: 0;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  @keyframes plant-in {
    from {
      transform: translate(-50%, -100%) rotate(var(--rot)) scale(0.3)
        translateY(8px);
      opacity: 0;
    }
    to {
      transform: translate(-50%, -100%) rotate(var(--rot)) scale(1)
        translateY(0);
      opacity: 1;
    }
  }
  @keyframes plant-out {
    from {
      transform: translate(-50%, -100%) rotate(var(--rot)) scale(1)
        translateY(0);
      opacity: 1;
    }
    to {
      transform: translate(-50%, -100%) rotate(var(--rot)) scale(0.98)
        translateY(4px);
      opacity: 0;
    }
  }

  /* Stage crossfades use independent fade-in and fade-out pairs with
     the same symmetric S-curve. Two adjacent stages crossfading this
     way keep their summed opacity ~1 the whole time (no ghost peak,
     no mid-fade dip). */
  @keyframes stage-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes stage-fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    #plant-trail { display: none; }
  }
</style>
