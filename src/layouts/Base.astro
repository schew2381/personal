---
import "~/styles/global.css";
import PaperBackground from "~/components/PaperBackground.astro";
import Botanicals from "~/components/Botanicals.astro";

interface Props {
  title: string;
  variant?: "home" | "page";
}
const { title, variant = "page" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <PaperBackground />
    <Botanicals variant={variant} />
    <main class="frame">
      <slot />
    </main>
    <style>
      .frame {
        position: relative;
        z-index: 1;
        max-width: 860px;
        margin: 0 auto;
        padding: clamp(3.5rem, 8vh, 6rem) clamp(1.25rem, 4vw, 2rem)
          clamp(5rem, 10vh, 8rem);
      }
    </style>
  </body>
</html>
